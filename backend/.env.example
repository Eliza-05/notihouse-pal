# Plantilla de variables de entorno del backend (NotiHouse-Pal API).
# Copia este archivo como backend/.env para desarrollo local.
# No escribas credenciales reales en este archivo.

# Entorno de ejecución: development | test | production
# En production Swagger se deshabilita.
NODE_ENV=development

# Puerto HTTP de la API (entero entre 1 y 65535).
# En Render este valor lo inyecta la plataforma.
PORT=3000

# Origen permitido por CORS (servidor de desarrollo de Vite).
FRONTEND_URL=http://localhost:5173

# Neon PostgreSQL: proyecto notihouse-pal, rama production, base neondb.
# Copiar desde el panel de Neon > Connect. Mantener las comillas dobles.
# Formato: postgresql://<usuario>:<contraseña>@<host>/neondb?sslmode=require&channel_binding=require
# (el backend trata sslmode=require como verify-full: verificación completa del certificado).

# Connection Pooling ACTIVADO (host con sufijo -pooler).
# La usa la API NestJS. Obligatoria salvo con NODE_ENV=test.
DATABASE_URL=""

# Connection Pooling DESACTIVADO (conexión directa).
# Solo la usan `npm run db:migrate` y `npm run db:check`; la API no la lee.
DATABASE_URL_DIRECT=""

# Secreto HS256 para firmar los JWT (mínimo 43 caracteres aleatorios = 32 bytes).
# Genéralo localmente, p. ej.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Obligatorio salvo con NODE_ENV=test. Nunca lo compartas ni lo subas a Git.
JWT_SECRET=

# Token Bearer del servicio de automatización (n8n) para las rutas /internal.
# Mínimo 43 caracteres aleatorios; distinto de JWT_SECRET. Genéralo igual que JWT_SECRET.
# Obligatorio con NODE_ENV=production; sin él, las rutas internas rechazan toda solicitud.
N8N_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Almacenamiento privado de archivos (facturas PDF y notas de voz)
# -----------------------------------------------------------------------------
# local: disco del equipo, SOLO desarrollo y pruebas (rechazado en production).
# s3: almacenamiento de objetos compatible con S3 (obligatorio en production,
#     porque el disco de Render es efímero). El bucket debe ser privado.
STORAGE_DRIVER=local
# Directorio del driver local. Vacío = backend/.local/storage (ignorado por Git).
STORAGE_LOCAL_PATH=
# Temporales de recepción multipart. Vacío = <tmp del sistema>/notihouse-uploads.
STORAGE_UPLOAD_TMP_PATH=
# Tamaños máximos en bytes (10 MiB y 25 MiB; techos: 50 MiB y 100 MiB).
STORAGE_MAX_PDF_BYTES=10485760
STORAGE_MAX_AUDIO_BYTES=26214400
# Solo con STORAGE_DRIVER=s3. Bucket y región obligatorios; el endpoint es para
# proveedores compatibles (https en production). Las dos claves van juntas o se
# omiten para usar la cadena de credenciales estándar del proveedor.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=false
