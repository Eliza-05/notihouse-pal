# Plantilla de variables de entorno del backend (NotiHouse-Pal API).
# Copia este archivo como backend/.env para desarrollo local.
# No escribas credenciales reales en este archivo.

# Entorno de ejecución: development | test | production
# En production Swagger se deshabilita.
NODE_ENV=development

# Puerto HTTP de la API (entero entre 1 y 65535).
# En Render este valor lo inyecta la plataforma.
PORT=3000

# Origen permitido por CORS (servidor de desarrollo de Vite).
FRONTEND_URL=http://localhost:5173

# Neon PostgreSQL: proyecto notihouse-pal, rama production, base neondb.
# Copiar desde el panel de Neon > Connect. Mantener las comillas dobles.
# Formato: postgresql://<usuario>:<contraseña>@<host>/neondb?sslmode=require&channel_binding=require
# (el backend trata sslmode=require como verify-full: verificación completa del certificado).

# Connection Pooling ACTIVADO (host con sufijo -pooler).
# La usa la API NestJS. Obligatoria salvo con NODE_ENV=test.
DATABASE_URL=""

# Connection Pooling DESACTIVADO (conexión directa).
# Solo la usan `npm run db:migrate` y `npm run db:check`; la API no la lee.
DATABASE_URL_DIRECT=""
