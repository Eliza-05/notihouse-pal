{
  "name": "notihouse-pal-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "nest build && node --env-file-if-exists=.env dist/database/scripts/db-check.js",
    "db:check:migrations": "drizzle-kit check",
    "db:seed:demo": "nest build && node --env-file-if-exists=.env dist/database/scripts/seed-demo.js",
    "db:demo:update-identities": "nest build && node --env-file-if-exists=.env dist/database/scripts/update-demo-identities.js",
    "db:demo:rotate-passwords": "nest build && node --env-file-if-exists=.env dist/database/scripts/rotate-demo-passwords.js",
    "smoke:api": "node dist/database/scripts/smoke-api.js",
    "storage:check": "nest build && node --env-file-if-exists=.env dist/storage/storage-check.js",
    "conc:env": "nest build && node dist/database/scripts/concurrency/generate-env.js",
    "conc:up": "docker compose -p notihouse-concurrency -f ../infra/testing/postgres-concurrency.compose.yml --env-file .local/concurrency.env up -d --wait",
    "conc:init": "nest build && node --env-file=.local/concurrency.env dist/database/scripts/concurrency/init-disposable-db.js",
    "conc:test": "vitest run --config ./vitest.config.pg.ts",
    "conc:suite": "nest build && node --env-file=.local/concurrency.env dist/database/scripts/concurrency/run-with-api-processes.js",
    "conc:down": "docker compose -p notihouse-concurrency -f ../infra/testing/postgres-concurrency.compose.yml --env-file .local/concurrency.env stop",
    "conc:destroy": "docker compose -p notihouse-concurrency -f ../infra/testing/postgres-concurrency.compose.yml --env-file .local/concurrency.env down -v"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1158.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.4",
    "multer": "2.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "@nestjs/cli": {
      "minimatch": "11.0.4"
    }
  }
}
