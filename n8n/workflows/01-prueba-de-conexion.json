    {
      "id": "6f1c2a10-0004-4a00-8a00-000000000004",
      "name": "Token de servicio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0],
      "notes": "Solo lectura. Sin X-Claim-Token, el backend valida el token y responde 400 sin consultar la base. UUID inexistente a proposito. 400 = autenticado; 401 = token rechazado.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "nhpApiService001",
          "name": "NotiHouse-Pal API (servicio)"
        }
      },
      "parameters": {
        "method": "GET",
        "url": "https://notihouse-pal-api.onrender.com/api/v1/internal/workflow-jobs/00000000-0000-4000-8000-000000000000",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
