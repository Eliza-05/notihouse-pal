    {
      "id": "7a2c3b60-0016-4b00-8b00-000000000016",
      "name": "Registrar recurrencia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rounds = $('Generar recurrencias').all().map((i) => i.json);\ntry { $getWorkflowStaticData('global').lastRecurrenceAt = Date.now(); } catch { /* ejecución manual */ }\nconst sum = (k) => rounds.reduce((a, r) => a + Number(r[k] ?? 0), 0);\nconst last = rounds[rounds.length - 1] ?? {};\nreturn [{ json: { recurrence: {\n  evaluationDate: last.evaluationDate ?? null, rounds: rounds.length, complete: last.complete === true,\n  scanned: sum('scanned'), obligationPeriodsCreated: sum('obligationPeriodsCreated'), rentChargesCreated: sum('rentChargesCreated'), unchanged: sum('unchanged'),\n  correlationId: last.correlationId ?? null,\n} } }];"
      }
    },
    {
      "id": "7a2c3b60-0017-4b00-8b00-000000000017",
      "name": "Anotar fallo de recurrencia",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const item = $input.first().json;\nconst detail = item.error ?? item;\nconst text = JSON.stringify(item);\nconst code = Number(detail?.httpCode ?? /^(\\d{3})\\b/.exec(String(detail?.cause?.message ?? detail?.message ?? ''))?.[1] ?? 0);\nconst killSwitch = /KILL_SWITCH_ACTIVE/.test(text) || code === 503;\n// No bloquea las alertas: se registra y el cierre deja la ejecución en error.\nconst message = killSwitch\n  ? 'Generación de recurrencias suspendida (kill switch recurrence_generation o backend no disponible, 503). Las alertas se evaluaron igualmente.'\n  : code === 401 ? 'Token de servicio rechazado (401) al generar recurrencias.'\n  : 'Fallo al generar recurrencias' + (code ? ' (HTTP ' + code + ')' : '') + '. Las alertas se evaluaron igualmente.';\nreturn [{ json: { recurrenceFailure: message } }];"
      }
    },
