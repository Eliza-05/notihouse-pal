      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Cierre único: informa el resultado y deja la ejecución en error si la recurrencia falló.\nlet failure = null;\ntry { failure = $('Anotar fallo de recurrencia').first().json.recurrenceFailure; } catch { /* no hubo fallo */ }\nlet recurrence = null;\ntry { recurrence = $('Registrar recurrencia').first().json.recurrence; } catch { /* no se ejecutó */ }\nif (failure) throw new Error(failure);\nreturn [{ json: { recurrence, alerts: 'evaluadas o en espera de la próxima hora' } }];"
      }
    },
    {
      "id": "7a2c3b60-0026-4b00-8b00-000000000026",
