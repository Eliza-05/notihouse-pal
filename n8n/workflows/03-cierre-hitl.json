      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "notes": "Solo hitl.decision. Sin reintentos: una respuesta perdida ya habría gastado un intento.",
      "credentials": {
        "httpHeaderAuth": {
          "id": "nhpApiService001",
          "name": "NotiHouse-Pal API (servicio)"
        }
      },
      "parameters": {
        "method": "POST",
        "url": "={{ $('Configuracion').first().json.apiBase }}/internal/workflow-jobs/claim",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workerId: $('Configuracion').first().json.workerId, limit: 1, leaseSeconds: $('Configuracion').first().json.leaseSeconds, jobTypes: ['hitl.decision'] }) }}",
        "options": {
          "timeout": 120000
        }
      }
