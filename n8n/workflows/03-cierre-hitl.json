    {
      "id": "8b3d4c30-0013-4c00-8c00-000000000013",
      "name": "Clasificar fallo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const claimed = $('Reclamar').first().json.jobs?.[0];\nconst item = $input.first().json;\nconst step = $prevNode.name;\nconst detail = item.error ?? item;\nconst raw = String(detail?.message ?? detail ?? '');\n// n8n sustituye el mensaje por un texto amigable; el código queda en la causa.\nconst code = Number(detail?.httpCode ?? item.httpCode ?? /^(\\d{3})\\b/.exec(String(detail?.cause?.message ?? ''))?.[1] ?? /^(\\d{3})\\b/.exec(raw)?.[1] ?? 0);\n\n// Con el caso ya cerrado, el trabajo no se puede volver a reclamar: reintentarlo\n// lo dejaría pendiente para siempre. Fallarlo aquí no afecta al caso, que es final.\nconst caseClosed = step === 'Completar trabajo';\nconst retryable = !caseClosed;\nconst reason = (caseClosed\n  ? 'El caso se cerró, pero no se pudo completar el trabajo'\n  : 'Fallo temporal en \"' + step + '\"') + (code ? ' (HTTP ' + code + ')' : '');\n\n// 401: configuración; fail también respondería 401. 409: la reclamación ya no es\n// válida o el estado no lo permite: se abandona sin escribir nada más.\nconst report = Boolean(claimed) && code !== 401 && code !== 409;\nconst message = code === 401\n  ? 'Token de servicio rechazado (401): revisa la credencial. No se registró el fallo.'\n  : code === 409\n    ? 'Conflicto (409) en \"' + step + '\". Trabajo abandonado sin escribir nada más: requiere revisión.'\n    : reason;\nreturn [{ json: {\n  report,\n  jobId: claimed?.id ?? null,\n  failBody: { claimToken: claimed?.claimToken, error: reason, retryable },\n  message,\n} }];"
      }
    },
