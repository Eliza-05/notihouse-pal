    {
      "id": "8b3d4c30-0009-4c00-8c00-000000000009",
      "name": "Preparar trabajo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const jobs = $input.first().json.jobs ?? [];\nif (jobs.length === 0) return [];\nconst job = jobs[0];\nconst p = job.payload ?? {};\nif (job.jobType !== 'hitl.decision') {\n  throw new Error('Se recibió un tipo de trabajo inesperado');\n}\n// La decisión ya la tomó y validó una persona en el backend: aquí solo se lee.\nif (p.decision !== 'approved' && p.decision !== 'rejected') {\n  throw new Error('El trabajo no contiene una decisión humana reconocible');\n}\nreturn [{ json: {\n  jobId: job.id,\n  claimToken: job.claimToken,\n  caseId: job.case.id,\n  correlationId: job.case.correlationId,\n  decision: p.decision,\n  decisionType: p.decisionType ?? null,\n  hitlRequestId: p.hitlRequestId ?? null,\n  proposalId: p.proposalId ?? null,\n} }];"
      }
    },
