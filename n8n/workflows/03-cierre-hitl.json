        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ claimToken: $('Preparar trabajo').first().json.claimToken, result: { hitlRequestId: $('Preparar trabajo').first().json.hitlRequestId, decision: $('Preparar trabajo').first().json.decision, decisionType: $('Preparar trabajo').first().json.decisionType, proposalId: $('Preparar trabajo').first().json.proposalId, caseStatus: $json.status, applicationCheckedByWorker: false } }) }}",
        "options": {
