      "notes": "Cambia AUTORIZAR_RECLAMACION a true solo para una ejecución real autorizada.",
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// ÚNICO interruptor de reclamación. Déjalo en false hasta autorizar una ejecución\n// real: con false, el workflow termina sin hacer ninguna solicitud.\nconst AUTORIZAR_RECLAMACION = false;\n\n// Etapa 7 — ejecución PROGRAMADA (disparador por intervalo). Exige además\n// AUTORIZAR_RECLAMACION. Con false, las ejecuciones programadas terminan sin\n// llamar a nada; la ejecución manual no cambia.\nconst AUTOMATIZACION_PROGRAMADA = false;\nconst scheduled = $input.first()?.json?.scheduled === true;\n\nreturn [{ json: {\n  authorized: AUTORIZAR_RECLAMACION,\n  scheduled,\n  scheduleEnabled: AUTOMATIZACION_PROGRAMADA,\n  // En la ruta programada no hay sondeo previo: Gemini solo se llama si hay un trabajo.\n  scheduledReady: scheduled && AUTORIZAR_RECLAMACION && AUTOMATIZACION_PROGRAMADA,\n  apiBase: 'https://notihouse-pal-api.onrender.com/api/v1',\n  workerId: 'n8n-local-1',\n  leaseSeconds: 300,\n} }];"
      }
    },
