# =============================================================================
# NotiHouse-Pal — Plantilla de variables de entorno
# -----------------------------------------------------------------------------
# - Copia este archivo como .env y completa los valores en tu entorno local.
# - NUNCA versiones el archivo .env ni escribas credenciales reales aquí.
# - Los nombres, valores y mecanismos de autenticación definitivos se
#   concretarán durante la implementación de cada componente.
# - Las variables de servicios externos (Gmail, LLM, STT, FCM) se agregarán
#   cuando dichos servicios se incorporen.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
# Entorno de ejecución: development | test | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Backend (NestJS)
# -----------------------------------------------------------------------------
# Puerto en el que escuchará la API REST
PORT=
# URL pública o local del backend (usada por el frontend y por n8n)
BACKEND_URL=

# -----------------------------------------------------------------------------
# Base de datos (PostgreSQL / Neon)
# -----------------------------------------------------------------------------
# Cadena de conexión a PostgreSQL. Formato de referencia:
# postgresql://<usuario>:<contraseña>@<host>:<puerto>/<base_de_datos>?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# Frontend (React + Vite)
# -----------------------------------------------------------------------------
# URL del frontend (p. ej. para configurar CORS en el backend)
FRONTEND_URL=

# -----------------------------------------------------------------------------
# Automatización (n8n)
# -----------------------------------------------------------------------------
# URL base de la instancia de n8n
N8N_BASE_URL=
# Token Bearer con el que n8n se autentica ante las rutas /api/v1/internal
# del backend (ver docs/api/workflow-integration.md). Distinto de JWT_SECRET.
N8N_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# Almacenamiento de archivos (backend)
# -----------------------------------------------------------------------------
# local solo en desarrollo; s3 (bucket privado) obligatorio en producción.
# Lista completa y descripción: backend/.env.example y docs/api/ingestion-api.md.
STORAGE_DRIVER=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Motor de vencimientos y alertas internas (Fase 4.2E)
# -----------------------------------------------------------------------------
# Parámetros operativos iniciales del MVP (no son requisitos legales).
# Zona horaria IANA para las fechas de calendario.
DUE_DATES_TIME_ZONE=America/Bogota
# Días de aviso antes del vencimiento (0-60, 0-60, 0-365) y horas antes del
# plazo en que una revisión HITL se considera urgente (1-24).
DUE_DATES_OBLIGATION_DAYS=7
DUE_DATES_RENT_CHARGE_DAYS=7
DUE_DATES_CONTRACT_DAYS=30
DUE_DATES_HITL_SOON_HOURS=6

# Proxies inversos de confianza delante de la API (0 a 3). 0 = se ignora
# X-Forwarded-For. En Render, fijarlo solo tras verificar la topología
# (docs/deployment/render-readiness.md). Nunca "true".
TRUST_PROXY_HOPS=0
